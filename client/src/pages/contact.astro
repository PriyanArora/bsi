---
import Layout from '../layouts/Layout.astro';
import ContactHero from '../components/contact/ContactHero.astro';
import ContactBento from '../components/contact/ContactBento.astro';
---

<Layout
  title="Contact BSI Solutionz - Technical Sales & Support"
  description="Contact BSI Solutionz for technical sales, after-sales support, product consultation, AMC care, and industrial lifting requirements."
>
  <div class="relative min-h-screen overflow-hidden pb-24 pt-[calc(var(--bsi-navbar-height)+2rem)]">
    <div class="relative z-10 mx-auto max-w-7xl px-6 md:px-8 lg:max-w-368 xl:max-w-392">
      <ContactHero />
      <ContactBento />
    </div>
  </div>
</Layout>
