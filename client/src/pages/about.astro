---
import Layout from '../layouts/Layout.astro';
import AboutHero from '../components/about/AboutHero.astro';
import AboutBento from '../components/about/AboutBento.astro';
---

<Layout
  title="About BSI Solutionz - Mission, Experience, and Support"
  description="Learn about BSI Solutionz, an authorized Bajaj Indef dealer with industrial lifting, material handling, installation, and after-handover support experience."
>
  <div class="relative overflow-hidden pb-24 pt-[calc(var(--bsi-navbar-height)+2rem)]">
    <div class="relative z-10 mx-auto max-w-7xl px-6 md:px-8 lg:max-w-368 xl:max-w-392">
      <AboutHero />
      <AboutBento />
    </div>
  </div>
</Layout>
