---
import IndustrialGridBackground from '../ui/IndustrialGridBackground.astro';

const trustPoints = [
  {
    icon: 'verified',
    title: 'Authorized Bajaj Indef Dealer',
    description: 'Genuine parts and certified engineering directly from the industry leader.'
  },
  {
    icon: 'workspace_premium',
    title: '10+ Years of Experience',
    description: 'Practical lifting, hoist, crane, generator and service knowledge built across real industrial sites.'
  },
  {
    icon: 'handshake',
    title: 'After Installation Support',
    description: 'Reliable follow-up for service queries, maintenance planning, parts support, and day-to-day equipment care.'
  }
];
---

<section class="relative overflow-hidden bg-white py-10 sm:py-12 md:py-14">
  <IndustrialGridBackground
    theme="light"
    cellSize={92}
    lineOpacity={0.2}
    markerOpacity={0.2}
    markerSize={5}
    fadeEdges={false}
    className="absolute inset-0"
  />

  <div class="relative z-10 mx-auto max-w-7xl px-6 md:px-8">
    <div class="max-w-4xl">
      <h2 class="font-headline text-bsi-primary text-3xl leading-tight font-extrabold sm:text-4xl md:text-5xl">
        Why BSI Solutionz ?
      </h2>
    </div>

    <div class="mt-7 grid grid-cols-1 gap-6 md:mt-8 md:grid-cols-3">
      {trustPoints.map((point) => (
        <article class="border-bsi-outline/30 bg-bsi-surface-lowest rounded-none border p-6 shadow-sm backdrop-blur-sm transition-transform duration-200 ease transform-gpu hover:-translate-y-1 hover:scale-[1.01]">
          <span class="material-symbols-outlined text-bsi-accent text-4xl leading-none">{point.icon}</span>
          <h4 class="text-bsi-primary mt-5 text-xl font-bold">{point.title}</h4>
          <p class="text-bsi-secondary mt-3 text-sm leading-relaxed sm:text-base">{point.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
