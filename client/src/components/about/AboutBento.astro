---
import { Image } from 'astro:assets';
import AboutRoadmap from './AboutRoadmap.astro';
import amcImage from '../../assets/shared/amc.jpg';

const services = [
  {
    title: 'Optional Site inspection',
    description: 'We study span, duty cycle, headroom, bay movement, power access, and operator needs before recommending equipment.'
  },
  {
    title: 'Installation coordination',
    description: 'Our team plans the work around site readiness, civil inputs, assembly sequence, safety access, and commissioning checks.'
  },
  {
    title: 'Follow up service',
    description: 'After handover, we stay available for service calls, parts support, preventive maintenance, and practical troubleshooting.'
  }
];
---

<section class="space-y-6 px-2 sm:px-4 md:px-8 lg:px-16">
  <div class="grid grid-cols-1 gap-6 lg:grid-cols-12">
    <article class="border-bsi-outline/30 bg-bsi-surface-lowest rounded-lg border p-6 sm:p-8 lg:col-span-7 lg:p-10">
      <p class="text-bsi-accent mb-3 text-xs font-bold uppercase tracking-[0.2em]">Our Mission</p>
      <h2 class="font-headline text-bsi-primary text-3xl leading-tight font-extrabold sm:text-4xl md:text-5xl">
        Installing lifting systems and diesel generators built for real industrial environments.
      </h2>
      <p class="text-bsi-secondary mt-6 max-w-3xl text-base leading-relaxed sm:text-lg">
        Built on a decade of stellar service, BSI Solutionz continues to define the standard for industrial lifting and material handling.
      </p>
      <p class="text-bsi-secondary mt-4 max-w-3xl text-base leading-relaxed sm:text-lg">
        Our job is to make the right equipment easier to select, install, operate, and maintain. We focus on clear coordination and dependable support after the machine is up and running.
      </p>
    </article>

    <aside class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:col-span-5 lg:grid-cols-1">
      <article class="border-bsi-outline/30 bg-bsi-surface-lowest rounded-lg border p-6 sm:p-7">
        <div class="font-headline text-bsi-accent text-5xl font-extrabold">10+</div>
        <h3 class="text-bsi-primary mt-2 text-2xl font-bold">Years in industrial lifting</h3>
        <p class="text-bsi-secondary mt-3 text-base leading-relaxed">
          Experience across cranes, hoists, material handling systems, AMC support, and diesel generator requirements.
        </p>
      </article>

      <article class="border-bsi-outline/30 bg-bsi-surface-lowest rounded-lg border p-6 sm:p-7">
        <div class="font-headline text-bsi-accent text-5xl font-extrabold">20+</div>
        <h3 class="text-bsi-primary mt-2 text-2xl font-bold">Years in generator expertise</h3>
        <p class="text-bsi-secondary mt-3 text-base leading-relaxed">
          Experience across diesel generators, power backup systems, installation support, AMC care, and clientele across India.
        </p>
      </article>
    </aside>
  </div>

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-12 lg:items-stretch">
    <article class="border-bsi-outline/30 bg-bsi-surface-lowest rounded-lg border p-6 sm:p-8 lg:col-span-7 lg:p-10">
      <div class="mb-8">
        <p class="text-bsi-accent mb-3 text-xs font-bold uppercase tracking-[0.2em]">How we work</p>
        <h3 class="font-headline text-bsi-primary text-3xl font-extrabold leading-tight">Process that keeps projects moving.</h3>
      </div>
      <AboutRoadmap />
    </article>

    <div class="grid grid-cols-1 gap-6 lg:col-span-5">
      <article class="border-bsi-outline/30 bg-bsi-surface-lowest rounded-lg border p-6 sm:p-8 lg:p-10">
        <p class="text-bsi-accent mb-3 text-xs font-bold uppercase tracking-[0.2em]">Project clarity</p>
        <h3 class="font-headline text-bsi-primary text-3xl font-extrabold leading-tight">Engineering judgment before every recommendation.</h3>
        <div class="mt-8 grid gap-5">
          {services.map((service, index) => (
            <div>
              <h4 class="text-bsi-primary font-bold">
                <span class="text-bsi-accent mr-2 font-extrabold">{index + 1}.</span>
                {service.title}
              </h4>
              <p class="text-bsi-secondary mt-1 text-sm leading-relaxed">{service.description}</p>
            </div>
          ))}
        </div>
      </article>

      <article class="relative overflow-hidden rounded-lg bg-bsi-primary p-6 text-white sm:p-8 lg:p-10">
        <Image
          src={amcImage}
          alt="BSI Solutionz service support"
          loading="lazy"
          decoding="async"
          width={640}
          sizes="(max-width: 1023px) 88vw, 35vw"
          class="absolute inset-0 h-full w-full object-cover opacity-30"
        />
        <div class="absolute inset-0 bg-bsi-primary/75" />
        <div class="relative">
          <p class="text-bsi-accent mb-3 text-xs font-bold uppercase tracking-[0.2em]">After handover</p>
          <h3 class="font-headline text-3xl font-extrabold leading-tight">Support that stays reachable.</h3>
          <p class="mt-5 text-lg leading-relaxed text-slate-100">
            Commissioning is not where the relationship ends. We help with operator queries, service planning, wear part replacement, and AMC care so the equipment remains reliable after installation.
          </p>
        </div>
      </article>
    </div>
  </div>
</section>
